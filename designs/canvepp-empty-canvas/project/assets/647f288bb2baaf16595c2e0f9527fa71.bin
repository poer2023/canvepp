.notice-sheet, .notice-sheet * { box-sizing: border-box; }
.notice-sheet {
  --paper: #f8f8f8;
  --ink: #1d1d1f;
  --muted: #58585d;
  --edge: #dedee1;
  --control: #fff;
  --mac-desk: #e4e9e9;
  --win-desk: #e4e9f0;
  --mac-notice: #f9fafb;
  --win-notice: #f9fafc;
  --focus: #364d70;
  width: 980px;
  height: 850px;
  padding: 35px 38px;
  background: var(--paper);
  color: var(--ink);
  font: 13px/1.45 -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  color-scheme: light;
}
.notice-sheet[data-theme="dark"] {
  --paper: #202020;
  --ink: #f3f3f3;
  --muted: #c0c0c3;
  --edge: #464649;
  --control: #303032;
  --mac-desk: #333c3d;
  --win-desk: #313946;
  --mac-notice: #29292b;
  --win-notice: #262a30;
  --focus: #b0c8ee;
  color-scheme: dark;
}
.notice-sheet :is(h1, h2, p) { margin: 0; }
.notice-sheet :where(button) {
  font: inherit;
  color: inherit;
  cursor: pointer;
  border: 0;
  background: transparent;
  padding: 0;
}
.notice-sheet button:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.sheet-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 23px;
}
.sheet-header h1 { font-size: 32px; font-weight: 650; line-height: 1.2; letter-spacing: -.04em; }
.sheet-header p { margin-top: 7px; color: var(--muted); font-size: 14px; }
.appearance-control {
  display: flex;
  align-items: center;
  padding: 2px;
  gap: 2px;
  border: 1px solid var(--edge);
  border-radius: 9px;
}
.appearance-control button { padding: 5px 11px; border: 1px solid transparent; border-radius: 6px; color: var(--muted); }
.appearance-control button[aria-pressed="true"] {
  background: var(--control);
  color: var(--ink);
  border-color: var(--edge);
  font-weight: 600;
}
.notice-matrix {
  display: grid;
  grid-template-columns: 100px repeat(2, minmax(0, 1fr));
  grid-template-rows: 25px repeat(3, 180px);
  gap: 12px;
  align-items: end;
}
.platform-heading { display: flex; align-items: baseline; justify-content: space-between; padding: 0 2px; }
.platform-heading h2 { font-size: 15px; font-weight: 650; }
.platform-heading span { color: var(--muted); font-size: 11px; }
.scenario-name {
  display: flex;
  align-self: stretch;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  border-top: 1px solid var(--edge);
  padding-right: 5px;
}
.scenario-name strong { font-size: 14px; }
.scenario-name span { color: var(--muted); font-size: 11px; }
.desktop-sample {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: flex-end;
  border-radius: 13px;
  padding: 12px;
  overflow: hidden;
}
.desktop-sample.macos { align-items: flex-start; background: var(--mac-desk); }
.desktop-sample.windows { align-items: flex-end; background: var(--win-desk); font-family: "Segoe UI Variable", "Segoe UI", "Microsoft YaHei", "PingFang SC", sans-serif; }
.notice-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 7px;
  width: 100%;
  max-width: 358px;
  padding: 11px 13px;
  text-align: left;
  border: 1px solid var(--edge);
}
.macos .notice-card { max-width: 340px; background: var(--mac-notice); border-radius: 15px; }
.windows .notice-card { background: var(--win-notice); border-radius: 9px; }
.notice-sheet button.notice-card:hover { border-color: var(--focus); }
.notice-attribution { display: flex; align-items: center; gap: 7px; color: var(--muted); font-size: 11px; }
.notice-attribution .age { margin-left: auto; }
.brand-mark {
  width: 17px;
  height: 17px;
  display: inline-grid;
  flex: none;
  place-items: center;
  background: var(--ink);
  color: var(--paper);
  border-radius: 4px;
}
.brand-mark svg { display: block; width: 12px; height: 12px; }
.notification-title { display: block; font-size: 14px; line-height: 1.35; font-weight: 660; }
.notification-body { display: block; margin-top: 2px; font-size: 12px; line-height: 1.45; color: var(--muted); }
.notification-with-thumb { display: flex; align-items: center; justify-content: space-between; gap: 9px; }
.image-attachment {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 2px;
  overflow: hidden;
  background: var(--edge);
  border-radius: 5px;
  min-width: 0;
}
.image-attachment.single { grid-template-columns: minmax(0, 1fr); }
.image-attachment img { display: block; width: 100%; height: 100%; min-width: 0; min-height: 0; object-fit: cover; }
.macos .image-attachment { width: 68px; height: 46px; flex: none; }
.macos .image-attachment.multi { grid-template-columns: 1.5fr 1fr; grid-template-rows: repeat(2, minmax(0, 1fr)); }
.macos .image-attachment.multi img:first-child { grid-row: span 2; }
.windows .image-attachment { height: 52px; grid-template-rows: minmax(0, 1fr); }
.windows .image-attachment.single img { object-position: 50% 53%; }
.notice-action-row { display: flex; margin-top: 1px; padding-top: 7px; border-top: 1px solid var(--edge); }
.notice-sheet .notice-action { padding: 5px 9px; background: var(--control); border: 1px solid var(--edge); border-radius: 6px; font-size: 12px; font-weight: 600; }
.notice-sheet .notice-action:hover { border-color: var(--focus); }
.windows .notice-action { width: 100%; }
.click-destination {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 40px;
  margin-top: 18px;
  padding: 8px 12px;
  background: var(--control);
  border: 1px solid var(--edge);
  border-radius: 8px;
  font-size: 12px;
}
.click-destination strong { font-weight: 650; white-space: nowrap; }
.click-destination span { color: var(--muted); }
