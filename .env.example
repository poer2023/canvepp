# Local-only data directory. Absolute path recommended when changing it.
CANVEPP_DATA_DIR=.data
# Real API remains blocked in this release even after UI settings are confirmed.
# Enabling it additionally requires verified model capabilities and a conservative
# total-request cost bound, then separate authorization for a minimal real test.
# Keep credentials server-side. Never paste keys into project files or this example.
# OPENAI_API_KEY=
# MCP bridge (loopback only)
CANVEPP_URL=http://127.0.0.1:3210
